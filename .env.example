# ============================================================
# ms-gastos-comunes - Variables de entorno
# Copia como `.env` (o defínelas en la task definition de ECS) y completa
# los valores reales. NUNCA commitees `.env` ni credenciales reales.
# Todo esto lee application.yml / application-aws.yml vía ${VAR:default}.
# ============================================================

# --- Perfil / servidor ---
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8083

# --- Microsoft Entra ID (mismas variables que el BFF) ---
ENTRA_TENANT_ID=936612c7-66b8-41ba-a9dd-83f50365f818
ENTRA_API_CLIENT_ID=528af346-c37c-40a0-9f7e-30162de3c027
# ENTRA_ISSUER=https://login.microsoftonline.com/936612c7-66b8-41ba-a9dd-83f50365f818/v2.0
# ENTRA_JWKS_URI=https://login.microsoftonline.com/936612c7-66b8-41ba-a9dd-83f50365f818/discovery/v2.0/keys
CLAIM_DE_ROL=roles
CLAIM_SEPARADOR=,

# --- Base de datos (solo perfil 'aws'; 'local' usa H2 en memoria) ---
DB_URL=jdbc:oracle:thin:@//REEMPLAZAR-ENDPOINT-RDS:1521/REEMPLAZAR_SERVICE_NAME
DB_USERNAME=REEMPLAZAR
DB_PASSWORD=REEMPLAZAR

# --- RabbitMQ / Amazon MQ (solo perfil 'aws') ---
RABBITMQ_URLS=amqps://REEMPLAZAR-BROKER-AMAZON-MQ:5671
RABBITMQ_USERNAME=REEMPLAZAR
RABBITMQ_PASSWORD=REEMPLAZAR
RABBITMQ_SSL_ENABLED=true
RABBITMQ_EXCHANGE_EVENTOS=espacios_events
RABBITMQ_COLA_RESERVA_CREADA=gastos_reserva_creada_queue

# --- Outbox/Inbox ---
OUTBOX_INTERVALO_MS=5000
OUTBOX_LOTE_MAXIMO=50
OUTBOX_MAX_INTENTOS=10
LISTENER_MAX_REINTENTOS=3

# --- Eureka / Config Server (solo perfil 'aws') ---
EUREKA_ENABLED=true
EUREKA_URL=http://REEMPLAZAR-EUREKA:8761/eureka/
CONFIG_SERVER_URL=http://REEMPLAZAR-CONFIG-SERVER:8888
